<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Row 1: device section label + rescan button -->
    <TextView
        android:id="@+id/label_devices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nearby Devices"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button_rescan"
        app:layout_constraintBottom_toBottomOf="@id/button_rescan"/>

    <Button
        android:id="@+id/button_rescan"
        style="@style/Widget.App.Button.Compact.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rescan"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 2: scanned device list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/devices_recycler_view"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/label_devices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/list_item_device"/>

    <!-- Row 3: firmware file picker -->
    <Button
        android:id="@+id/button_select_file"
        style="@style/Widget.App.Button.Compact.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select DFU File"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/devices_recycler_view"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/text_selected_file"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="middle"
        android:singleLine="true"
        app:layout_constraintStart_toEndOf="@id/button_select_file"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/button_select_file"
        app:layout_constraintBottom_toBottomOf="@id/button_select_file"
        tools:text="firmware_v1.2.3.zip"/>

    <!-- Row 4: config fields -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_iterations"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Iterations"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/button_select_file"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_vertical_50">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_iterations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="10"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_timeout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Timeout (s)"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/button_select_file"
        app:layout_constraintStart_toEndOf="@id/guideline_vertical_50"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="120"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Row 5: start/stop button -->
    <Button
        android:id="@+id/button_start_stop_test"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Start Test"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/layout_iterations"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Stats section: pie chart on the right, progress bars on the left -->
    <com.example.bledfutesteractivity.PieChartView
        android:id="@+id/pie_chart"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/button_start_stop_test"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/text_pie_legend"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textAlignment="center"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/pie_chart"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="✓0  ✗0  …0"/>

    <TextView
        android:id="@+id/text_iteration_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="–"
        android:textSize="12sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="@id/pie_chart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pie_chart"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/text_iteration_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pie_chart"/>

    <TextView
        android:id="@+id/text_dfu_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Upload: 0%"
        android:textSize="12sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pie_chart"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar_dfu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/text_dfu_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pie_chart"/>

    <!-- Barrier: log starts below whichever is taller (pie or last progress bar) -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_stats_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="text_pie_legend,progress_bar_dfu"/>

    <!-- Log area -->
    <ScrollView
        android:id="@+id/log_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F5F5F5"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/barrier_stats_bottom"
        app:layout_constraintBottom_toTopOf="@id/button_share_log"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/log_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="11sp"
            android:typeface="monospace"
            tools:text="Log message 1...\nLog message 2..."/>
    </ScrollView>

    <!-- Bottom action buttons (hidden until test finishes) -->
    <Button
        android:id="@+id/button_new_test"
        style="@style/Widget.App.Button.Compact.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Test"
        android:visibility="gone"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible"/>

    <Button
        android:id="@+id/button_share_log"
        style="@style/Widget.App.Button.Compact.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share Log"
        android:visibility="gone"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_vertical_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"/>

</androidx.constraintlayout.widget.ConstraintLayout>
